{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null && query.orderByChild == 'meta/activeAt' && query.limitToFirst != null && query.limitToFirst <= 25",
      ".indexOn": [
        "meta/activeAt"
      ],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.exists() && !newData.exists() && (data.child('meta/hostId').val() === auth.uid || !data.child('meta').exists() || data.child('meta/activeAt').val() < now - 21600000)",
        ".validate": "$code.matches(/^[A-HJ-NP-Z]{4}$/)",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('hostId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostId', 'status', 'createdAt'])",
          "hostId": {
            ".write": "auth != null && newData.val() === auth.uid && data.exists() && root.child('rooms/' + $code + '/players/' + auth.uid).exists() && (!root.child('rooms/' + $code + '/players/' + data.val()).exists() || (root.child('rooms/' + $code + '/presence/' + data.val() + '/online').val() === false && root.child('rooms/' + $code + '/presence/' + data.val() + '/lastSeen').val() < now - 8000) || (root.child('rooms/' + $code + '/meta/status').val() === 'playing' && root.child('rooms/' + $code + '/meta/hostBeat').val() < now - 8000))",
            ".validate": "newData.isString() && newData.val().length < 128"
          },
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "activeAt": {
            ".validate": "newData.isNumber()"
          },
          "hostBeat": {
            ".validate": "newData.isNumber()"
          },
          "settings": {
            ".validate": "newData.hasChildren()"
          },
          "$other": {
            ".validate": false
          },
          "used": {
            "$game": {
              "$id": {
                ".validate": "newData.isBoolean()"
              }
            }
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && root.child('rooms/' + $code + '/meta').exists() && !root.child('rooms/' + $code + '/kicked/' + $uid).exists()) || (!newData.exists() && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'color', 'avatar', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['online', 'lastSeen'])",
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "kicked": {
          "$uid": {
            ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && $uid !== auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "game": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid"
        },
        "boards": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$round": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/rk').val() === $round && root.child('rooms/' + $code + '/game/phase').val() === 'play' && root.child('rooms/' + $code + '/game/participants/' + $uid).exists()",
                ".validate": "newData.hasChildren(['p', 'done'])",
                "g": {
                  "$i": {
                    ".validate": "$i.matches(/^[0-5]$/) && newData.isString() && newData.val().length <= 16"
                  }
                },
                "p": {
                  "$i": {
                    ".validate": "$i.matches(/^[0-5]$/) && newData.isString() && newData.val().matches(/^[012]{4,8}$/)"
                  }
                },
                "solved": {
                  ".validate": "newData.isBoolean()"
                },
                "done": {
                  ".validate": "newData.isBoolean()"
                },
                "solvedAt": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "at": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "answers": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$q": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $code + '/game/id').val() === 'signal' && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/qk').val() === $q && root.child('rooms/' + $code + '/game/phase').val() === 'question' && root.child('rooms/' + $code + '/game/participants/' + $uid).exists() && !root.child('rooms/' + $code + '/game/out/' + $uid).exists()",
                ".validate": "newData.hasChildren(['c', 'at'])",
                "c": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3 && newData.val() % 1 === 0"
                },
                "at": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "targets": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/game/id').val() === 'signal' && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/participants/' + $uid).exists()",
              ".validate": "newData.isString() && newData.val().length < 128 && newData.val() !== $uid && root.child('rooms/' + $code + '/game/participants/' + newData.val()).exists()"
            }
          }
        },
        "oc": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$c": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/game/id').val() === 'overclock' && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/ck').val() === $c && root.child('rooms/' + $code + '/game/phase').val() === 'play' && root.child('rooms/' + $code + '/game/participants/' + $uid).exists() && !(data.child('done').val() === true)",
                ".validate": "newData.hasChildren(['p', 'ok', 'n', 'done', 'at']) && newData.child('ok').val() <= newData.child('p').val() && newData.child('p').val() <= newData.child('n').val()",
                "p": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 12"
                },
                "ok": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "n": {
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
                },
                "done": {
                  ".validate": "newData.isBoolean()"
                },
                "at": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "doneAt": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "lies": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$r": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/game/id').val() === 'bluff' && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/rk').val() === $r && root.child('rooms/' + $code + '/game/phase').val() === 'write' && root.child('rooms/' + $code + '/game/participants/' + $uid).exists()",
                ".validate": "newData.hasChildren(['t', 'at'])",
                "t": {
                  ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
                },
                "at": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "votes": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$r": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/game/id').val() === 'bluff' && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/rk').val() === $r && root.child('rooms/' + $code + '/game/phase').val() === 'vote' && root.child('rooms/' + $code + '/game/participants/' + $uid).exists()",
                ".validate": "newData.hasChildren(['k', 'at'])",
                "k": {
                  ".validate": "newData.isString() && newData.val().length <= 16"
                },
                "like": {
                  ".validate": "newData.isString() && newData.val().length <= 16"
                },
                "at": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "pulse": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/game/id').val() === 'pulse' && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/participants/' + $uid).exists()",
              ".validate": "newData.hasChildren(['k', 's', 'at']) && newData.child('k').val() === root.child('rooms/' + $code + '/game/si').val()",
              "k": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9" },
              "ready": { ".validate": "newData.isBoolean()" },
              "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
              "c": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
              "mc": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
              "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
              "g": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
              "o": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
              "m": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
              "n": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20000" },
              "e": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 30000" },
              "er": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
              "at": { ".validate": "newData.isNumber() && newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        },
        "golf": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/game/id').val() === 'golf' && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/phase').val() === 'play' && root.child('rooms/' + $code + '/game/participants/' + $uid).exists()",
              ".validate": "newData.hasChildren(['h', 's', 'x', 'y', 'st', 'at']) && newData.child('h').val() === root.child('rooms/' + $code + '/game/hi').val()",
              "h": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8" },
              "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8" },
              "x": { ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 500" },
              "y": { ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 500" },
              "st": { ".validate": "newData.val() === 'aim' || newData.val() === 'roll' || newData.val() === 'done'" },
              "f": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 7 && (newData.val() === newData.parent().child('s').val() || newData.val() === 7) && (!data.exists() || data.val() === newData.val() || data.parent().child('h').val() !== newData.parent().child('h').val())" },
              "pu": { ".validate": "newData.val() === '' || newData.val() === 'ghost' || newData.val() === 'sticky' || newData.val() === 'magnet'" },
              "pk": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 255" },
              "ls": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999999999" },
              "le": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999999999" },
              "ri": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8" },
              "rt": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
              "sh": {
                ".validate": "newData.hasChildren(['x', 'y', 'a', 'p', 't'])",
                "x": { ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 500" }, "y": { ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 500" }, "a": { ".validate": "newData.isNumber() && newData.val() >= -7 && newData.val() <= 7" },
                "p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
                "t": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000" },
                "pu": { ".validate": "newData.val() === '' || newData.val() === 'ghost' || newData.val() === 'sticky' || newData.val() === 'magnet'" },
                "$other": { ".validate": false }
              },
              "b": {
                ".validate": "newData.hasChildren(['x', 'y', 't'])",
                "x": { ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 500" }, "y": { ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 500" }, "z": { ".validate": "newData.isNumber() && newData.val() >= -500 && newData.val() <= 500" }, "vx": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100" }, "vy": { ".validate": "newData.isNumber() && newData.val() >= -100 && newData.val() <= 100" }, "t": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999999999" },
                "$other": { ".validate": false }
              },
              "sab": {
                ".validate": "newData.hasChildren(['h', 'to', 'k', 'at']) && newData.child('h').val() === root.child('rooms/' + $code + '/game/hi').val() && root.child('rooms/' + $code + '/game/participants/' + newData.child('to').val()).exists() && newData.child('to').val() !== $uid && (!data.exists() || data.child('h').val() !== newData.child('h').val() || (data.child('to').val() === newData.child('to').val() && data.child('k').val() === newData.child('k').val() && data.child('at').val() === newData.child('at').val()))",
                "h": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 8" },
                "to": { ".validate": "newData.isString() && newData.val().length <= 128" },
                "k": { ".validate": "newData.val() === 'fog' || newData.val() === 'wobble' || newData.val() === 'shake'" },
                "at": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 9999999999999" },
                "$other": { ".validate": false }
              },
              "ball": {
                "c": { ".validate": "newData.isString() && newData.val().length <= 9" },
                "f": { ".validate": "newData.val() === 'neon' || newData.val() === 'chrome' || newData.val() === 'glass'" },
                "t": { ".validate": "newData.val() === 'ribbon' || newData.val() === 'sparks' || newData.val() === 'pixels'" },
                "$other": { ".validate": false }
              },
              "at": { ".validate": "newData.isNumber() && newData.val() === now" },
              "$other": { ".validate": false }
            }
          }
        },
        "night": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid",
          "$match": {
            ".validate": "newData.hasChildren(['g', 'p'])"
          }
        }
      }
    }
  }
}
