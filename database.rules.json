{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      ".read": "auth != null && query.orderByChild == 'meta/activeAt' && query.limitToFirst != null && query.limitToFirst <= 25",
      ".indexOn": [
        "meta/activeAt"
      ],
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && data.exists() && !newData.exists() && (data.child('meta/hostId').val() === auth.uid || !data.child('meta').exists() || data.child('meta/activeAt').val() < now - 21600000)",
        ".validate": "$code.matches(/^[A-HJ-NP-Z]{4}$/)",
        "meta": {
          ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() === auth.uid) || data.child('hostId').val() === auth.uid)",
          ".validate": "newData.hasChildren(['hostId', 'status', 'createdAt'])",
          "hostId": {
            ".write": "auth != null && newData.val() === auth.uid && data.exists() && root.child('rooms/' + $code + '/players/' + auth.uid).exists() && (!root.child('rooms/' + $code + '/players/' + data.val()).exists() || (root.child('rooms/' + $code + '/presence/' + data.val() + '/online').val() === false && root.child('rooms/' + $code + '/presence/' + data.val() + '/lastSeen').val() < now - 8000) || (root.child('rooms/' + $code + '/meta/status').val() === 'playing' && root.child('rooms/' + $code + '/meta/hostBeat').val() < now - 8000))",
            ".validate": "newData.isString() && newData.val().length < 128"
          },
          "status": {
            ".validate": "newData.val() === 'lobby' || newData.val() === 'playing'"
          },
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "activeAt": {
            ".validate": "newData.isNumber()"
          },
          "hostBeat": {
            ".validate": "newData.isNumber()"
          },
          "settings": {
            ".validate": "newData.hasChildren()"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && root.child('rooms/' + $code + '/meta').exists() && !root.child('rooms/' + $code + '/kicked/' + $uid).exists()) || (!newData.exists() && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['name', 'color', 'avatar', 'joinedAt'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "color": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "presence": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid))",
            ".validate": "newData.hasChildren(['online', 'lastSeen'])",
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "kicked": {
          "$uid": {
            ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && $uid !== auth.uid",
            ".validate": "newData.isBoolean()"
          }
        },
        "game": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid"
        },
        "boards": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$round": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/rk').val() === $round && root.child('rooms/' + $code + '/game/phase').val() === 'play' && root.child('rooms/' + $code + '/game/participants/' + $uid).exists()",
                ".validate": "newData.hasChildren(['p', 'done'])",
                "g": {
                  "$i": {
                    ".validate": "$i.matches(/^[0-5]$/) && newData.isString() && newData.val().length <= 16"
                  }
                },
                "p": {
                  "$i": {
                    ".validate": "$i.matches(/^[0-5]$/) && newData.isString() && newData.val().matches(/^[012]{4,8}$/)"
                  }
                },
                "solved": {
                  ".validate": "newData.isBoolean()"
                },
                "done": {
                  ".validate": "newData.isBoolean()"
                },
                "solvedAt": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "at": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "answers": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$q": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $code + '/game/id').val() === 'signal' && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/qk').val() === $q && root.child('rooms/' + $code + '/game/phase').val() === 'question' && root.child('rooms/' + $code + '/game/participants/' + $uid).exists() && !root.child('rooms/' + $code + '/game/out/' + $uid).exists()",
                ".validate": "newData.hasChildren(['c', 'at'])",
                "c": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3 && newData.val() % 1 === 0"
                },
                "at": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        },
        "targets": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/game/id').val() === 'signal' && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/participants/' + $uid).exists()",
              ".validate": "newData.isString() && newData.val().length < 128 && newData.val() !== $uid && root.child('rooms/' + $code + '/game/participants/' + newData.val()).exists()"
            }
          }
        },
        "oc": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/hostId').val() === auth.uid && !newData.exists()",
          "$match": {
            "$c": {
              "$uid": {
                ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/game/id').val() === 'overclock' && root.child('rooms/' + $code + '/game/matchId').val() === $match && root.child('rooms/' + $code + '/game/ck').val() === $c && root.child('rooms/' + $code + '/game/phase').val() === 'play' && root.child('rooms/' + $code + '/game/participants/' + $uid).exists() && !(data.child('done').val() === true)",
                ".validate": "newData.hasChildren(['p', 'ok', 'n', 'done', 'at']) && newData.child('ok').val() <= newData.child('p').val() && newData.child('p').val() <= newData.child('n').val()",
                "p": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 12"
                },
                "ok": {
                  ".validate": "newData.isNumber() && newData.val() >= 0"
                },
                "n": {
                  ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12"
                },
                "done": {
                  ".validate": "newData.isBoolean()"
                },
                "at": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "doneAt": {
                  ".validate": "newData.isNumber() && newData.val() === now"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        }
      }
    }
  }
}
