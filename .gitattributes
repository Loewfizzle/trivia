# Line endings: LF everywhere, in the repo and in the working copy (on Windows too). A CRLF working copy broke exact-match edits
# and the scripts that make them; the repo itself has always stored LF.
* text=auto eol=lf

# binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.woff binary
*.woff2 binary
